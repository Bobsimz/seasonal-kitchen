SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=5433
DB_NAME=seasonal_dining
DB_USERNAME=seasonal
DB_PASSWORD=seasonal

# Supabase profile. Use when SPRING_PROFILES_ACTIVE=supabase.
# Direct connection example:
# SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Transaction pooler example:
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

KAMIS_API_KEY=change-me
KAMIS_API_ID=change-me

# 미디어 스토리지: 로컬 개발은 기본 디스크 저장(UPLOADS_STORAGE 미설정=local).
# S3로 테스트하려면 아래 주석을 해제하고 S3 계정 키를 넣는다(프로덕션은 서버 .env에서 설정).
# UPLOADS_STORAGE=s3
# S3_BUCKET=<bucket-name>
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=<access-key-id>
# AWS_SECRET_ACCESS_KEY=<secret-access-key>
# UPLOADS_PUBLIC_BASE_URL=https://<cloudfront-domain>

LLM_API_KEY=change-me
