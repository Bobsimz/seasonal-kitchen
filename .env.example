# 서버(Lightsail)의 배포 폴더에 .env 로 복사해 채운다. git 에는 올리지 않는다.
# docker-compose.prod.yml 의 backend 컨테이너에 주입된다.

# ── Supabase (운영 DB) ──
# transaction pooler 사용 시 URL 끝에 prepareThreshold=0 추가
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<database-password>

# ── JWT (운영용 랜덤 시크릿, 최소 32자) ──
# 생성 예: openssl rand -base64 48
JWT_SECRET=<replace-with-strong-random-secret>

# ── (선택) 데모 시드 데이터 ──
DEMO_SEED_ENABLED=false
