# 서버(Lightsail)의 배포 폴더에 .env 로 복사해 채운다. git 에는 올리지 않는다.
# docker-compose.prod.yml 의 backend 컨테이너에 주입된다.

# ── Supabase (운영 DB) ──
# transaction pooler 사용 시 URL 끝에 prepareThreshold=0 추가
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<database-password>

# ── JWT (운영용 랜덤 시크릿, 최소 32자) ──
# 생성 예: openssl rand -base64 48
JWT_SECRET=<replace-with-strong-random-secret>

# ── 미디어 스토리지 (S3 + CloudFront) ──
# 설정 시 업로드/릴 미디어를 S3에 저장하고 CloudFront URL을 반환한다(미설정이면 컨테이너 로컬 디스크).
# 액세스 키는 버킷이 있는 S3 계정의 IAM 사용자 키(최소권한: s3:PutObject/GetObject).
UPLOADS_STORAGE=s3
S3_BUCKET=<bucket-name>
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=<s3-account-access-key-id>
AWS_SECRET_ACCESS_KEY=<s3-account-secret-access-key>
# 영상/이미지 공개 URL의 base = CloudFront 도메인. CloudFront 생성 후 채운다.
UPLOADS_PUBLIC_BASE_URL=https://<cloudfront-domain>

# ── (선택) 데모 시드 데이터 ──
DEMO_SEED_ENABLED=false
